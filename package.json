{
  "name": "platformkit-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{app,src,tests,scripts}/**/*.{ts,tsx}\" \"app.config.ts\"",
    "format:check": "prettier --check \"{app,src,tests,scripts}/**/*.{ts,tsx}\" \"app.config.ts\"",
    "test": "tsx --test tests/*.test.ts && jest",
    "check": "npm run check:sdk && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:fingerprint && npm run check:flows",
    "check:sdk": "expo install --check",
    "fingerprint": "tsx scripts/fingerprint.ts",
    "check:fingerprint": "tsx scripts/fingerprint.ts --check",
    "export:check": "expo export --platform android --platform ios --output-dir \"${RUNNER_TEMP:-/tmp}/platformkit-mobile-export\"",
    "tokens": "tsx scripts/tokens.ts",
    "test:ui": "jest",
    "check:flows": "tsx scripts/check_flows.ts",
    "source": "tsx scripts/source.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "expo": "57.0.21",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-modules-core": "57.0.17",
    "expo-router": "57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.20.12",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.3.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
