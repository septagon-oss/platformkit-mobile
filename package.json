{
  "name": "platformkit-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "exports": {
    "./core/catalog": "./src/core/catalog.ts",
    "./core/derive": "./src/core/derive.ts",
    "./effects/api": "./src/effects/api.ts",
    "./renderers": "./src/renderers.ts",
    "./route": "./src/route.tsx",
    "./shell": "./src/shell.tsx",
    "./tools/tokens": "./scripts/tokens.ts",
    "./tools/android": "./scripts/android/build.sh",
    "./screens/*": "./src/screens/*.tsx",
    "./ui/theme": "./src/ui/theme.tsx",
    "./ui/gallery": "./src/ui/gallery.tsx",
    "./ui/scale": "./src/ui/scale.ts",
    "./ui/atoms/*": "./src/ui/atoms/*.tsx",
    "./ui/molecules/*": "./src/ui/molecules/*.tsx",
    "./ui/organisms/*": "./src/ui/organisms/*.tsx",
    "./ui/templates/*": "./src/ui/templates/*.tsx",
    "./effects/media": "./src/effects/media.ts",
    "./screens/NativeMap": {
      "react-native": "./src/screens/NativeMap.native.tsx",
      "default": "./src/screens/NativeMap.tsx"
    },
    "./generated": "./src/generated/index.ts"
  },
  "files": [
    "src",
    "scripts/tokens.ts",
    "scripts/android",
    "NOTICE"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{app,src,tests,scripts}/**/*.{ts,tsx}\" \"app.config.ts\"",
    "format:check": "prettier --check \"{app,src,tests,scripts}/**/*.{ts,tsx}\" \"app.config.ts\"",
    "test": "node --import tsx --test tests/*.test.ts && jest",
    "check": "npm run check:api && npm run check:sdk && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:fingerprint && npm run check:flows && npm run check:source",
    "check:sdk": "EXPO_OFFLINE=1 expo install --check",
    "sdk:latest": "expo install --check",
    "fingerprint": "node --import tsx scripts/fingerprint.ts",
    "check:fingerprint": "node --import tsx scripts/fingerprint.ts --check",
    "export:check": "expo export --platform android --platform ios --output-dir \"${RUNNER_TEMP:-/tmp}/platformkit-mobile-export\"",
    "tokens": "node --import tsx scripts/tokens.ts",
    "test:ui": "jest",
    "check:flows": "node --import tsx scripts/check_flows.ts",
    "source": "node --import tsx scripts/source.ts",
    "check:source": "node --import tsx scripts/source.ts --check",
    "check:kernel-main": "node --import tsx scripts/kernel_main.ts",
    "check:advisories": "node --import tsx scripts/advisories.ts --check",
    "references": "node --import tsx scripts/references.ts",
    "check:references": "node --import tsx scripts/references.ts --check",
    "api": "node --import tsx scripts/api.ts",
    "check:api": "node --import tsx scripts/api.ts --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@js-temporal/polyfill": "0.5.1",
    "@maplibre/maplibre-react-native": "11.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "expo": "57.0.23",
    "expo-asset": "57.0.17",
    "expo-build-properties": "~57.0.19",
    "expo-constants": "57.0.18",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "57.0.10",
    "expo-modules-core": "57.0.18",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-zoom-toolkit": "5.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.20.12",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.3.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
